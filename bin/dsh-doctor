#!/bin/sh
# ============================================================
#  dsh-doctor —— 一条命令体检 + 自动修
#
#  用法:
#    dsh-doctor              只体检，列出问题（安全，默认）
#    dsh-doctor --fix        体检 + 自动修能修的
#    dsh-doctor --json       机器可读
#
#  能自动修的:
#    · seq 断档        → dsh-repair
#    · 非核心事件类型   → 只报告，不自动剥（用 --strip-type 显式指定）
#
#  只报告、不自动修的:
#    · 会话格式变了（v4 → v5）—— 需要人工确认
#    · 文件读不了 / 解压失败
#    · 太久没备份
#
#  安全模型:
#    · 默认不写任何东西
#    · --fix 前每个会话都先备份成 *.before-doctor
#    · 出问题用 dsh-doctor --rollback 回退
# ============================================================
set -u

TOOLS_VERSION="2.0.9"
HOME_DIR="${HOME:-/root}"
DSH="$HOME_DIR/.dsh"
SESS="$DSH/sessions"

MODE="check"
STRIP_TYPE=""
STRIP_MODE="mark"
SKIP_NEXT=0
for a in "$@"; do
  if [ "$SKIP_NEXT" = "1" ]; then STRIP_TYPE="$STRIP_TYPE $a"; SKIP_NEXT=0; continue; fi
  case "$a" in
    --fix)         MODE="fix" ;;
    --remove)      STRIP_MODE="remove" ;;
    --strip-type)  SKIP_NEXT=1 ;;
    --strip-type=*) STRIP_TYPE="$STRIP_TYPE ${a#*=}" ;;
    --strip-type*)
      # 漏了空格：--strip-typejob/registered
      # 注意：这里还不能用 die()，函数在下面才定义
      printf '❌ 选项没写对：%s\n' "$a" >&2
      printf '   是不是 --strip-type 后面漏了空格？应该是：\n' >&2
      printf "     dsh-doctor --fix --strip-type '类型名'\n" >&2
      printf '   例如：\n' >&2
      printf '     dsh-doctor --fix --strip-type job/registered\n' >&2
      exit 1 ;;
    --json)     MODE="json" ;;
    --rollback) MODE="rollback" ;;
    --i-know)   : ;;              # 配合 --fix，跳过「Web 还在跑」的拦截
    -h|--help)
      sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) printf '❌ 不认识的选项: %s\n' "$a" >&2; exit 1 ;;
  esac
done

# ------------------------------------------------------------
#  容错：从应用报错里复制粘贴时，很容易把整段带进来
#
#    dsh-doctor --fix --strip-type "job/registered" (seq 14511)
#                                     ^引号            ^括号
#
#  规则：去掉引号；如果还有空格或括号，只取第一个词并提示。
#  不这么做用户会撞在 bash 语法错误上，而不是看到有用的信息。
# ------------------------------------------------------------
if [ -n "$STRIP_TYPE" ]; then
  RAW_STRIP=$(printf '%s' "$STRIP_TYPE" | sed 's/^ *//')
  # 事件类型名不会含空格，所以取第一个词就够
  FIRST=$(printf '%s' "$RAW_STRIP" | awk '{print $1}' | tr -d '"'"'"'' | sed 's/[;:,.。，]*$//')
  if [ "$FIRST" != "$RAW_STRIP" ]; then
    printf 'ℹ️  参数里有多余内容，只用了第一个词\n' >&2
    printf '   你给的: %s\n' "$RAW_STRIP" >&2
    printf '   用的:   %s\n' "$FIRST" >&2
    printf '   （事件类型名不含空格，所以不会误判）\n' >&2
  fi
  STRIP_TYPE="$FIRST"
fi

say()  { printf '%s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -d "$DSH" ] || die "找不到 $DSH"
have python3 || die "需要 python3"

# ============================================================
#  已知事件类型 —— 从**已安装的 harness** 里读，不是写死的
#
#  ⚠️ 1.4.x 这里是一个硬编码列表，按 0.2.1 统计出来的。
#     在 0.2.0 上完全失效：0.2.0 不认识 job/registered，
#     但列表里有它，于是报「全部认识」，应用照样读不了。
#     **假阴性比不检查更糟** —— 用户以为没事。
#
#  现在用 dsh-events 读 harness 里的 SessionEventMap，
#  那才是「这份安装到底认识什么」的权威来源。
# ============================================================
KNOWN_EVENTS=""
EVENTS_SOURCE="none"
if have dsh-events; then
  KNOWN_EVENTS=$(dsh-events 2>/dev/null | tr '\n' ' ' | sed 's/ $//')
  [ -n "$KNOWN_EVENTS" ] && EVENTS_SOURCE="harness"
fi
# session 是日志头事件，永远合法，不在 SessionEventMap 里
KNOWN_EVENTS="$KNOWN_EVENTS session"
if [ -z "$KNOWN_EVENTS" ]; then
  # 兜底：这份列表只能当参考，明确标出来，不假装权威
  KNOWN_EVENTS="session step/start step/end turn/start turn/end assistant/message
assistant/attempt tool/call tool/result user/message system/message developer/message
session/title session/title-llm-request session/end-seed model/selection request/header
request/context llm/retry llm/retry-started compaction/start compaction/end
compaction/summary compaction/prune agent/inbox/spliced agent-preset/selected
job/registered job/settled todo/write goal/change permission/preset sandbox/mode
approval/policy workspace/changes deliverables/presented web/deepseek-search-llm-request
session-log-deepseek/delivery-accepted"
  EVENTS_SOURCE="fallback"
fi
KNOWN_SESSION_FORMATS="v4"

NOW=$(date +%s)

# ============================================================
#  --rollback
# ============================================================
if [ "$MODE" = "rollback" ]; then
  N=0
  find "$SESS" -name '*.before-doctor' -type f 2>/dev/null | while IFS= read -r f; do
    t="${f%.before-doctor}"
    [ -f "$t" ] && cp -a "$f" "$t" && printf '  ↩︎  %s\n' "${t#$SESS/}"
  done
  say "✅ 已回退（*.before-doctor → 原文件）"
  exit 0
fi

# ============================================================
#  各项检查
# ============================================================
T=$(mktemp -d "${TMPDIR:-/tmp}/dsh-doctor.XXXXXX")
trap 'rm -rf "$T"' EXIT INT TERM

: > "$T/issues"

# ---- 1. 环境 ----
APPV=$(timeout 8 curl -s -H @/root/.dsh/.bridge_headers "http://127.0.0.1:3090/app/version" 2>/dev/null \
       | sed -n 's/.*APP_VERSION=\([^\\]*\).*/\1/p' | head -1)
APPV=${APPV:-未知}
MISS=""
for c in tar stat find cp sed grep head mktemp python3; do
  have "$c" || MISS="$MISS $c"
done

# ---- 2. 会话 ----
SESS_FILES=$(find "$SESS" -type f -name 'session.v*.jsonl.zstd' 2>/dev/null)
N_SESS=$(printf '%s\n' "$SESS_FILES" | grep -c . || true)
FMT=$(printf '%s\n' "$SESS_FILES" | sed -n 's|.*/session\.\(v[0-9][0-9]*\)\.jsonl\.zstd$|\1|p' | sort -u | tr '\n' ' ' | sed 's/ $//')

UNREADABLE=0
BAD_SEQ=0
UNKNOWN_EV=0
TOTAL_EV=0

if [ "$N_SESS" -gt 0 ]; then
  # 一次 Python 调用读完所有会话（用 libzstd，不依赖 zstd 命令）。
  # 输出: UNREADABLE / GAP / NONCORE / FRAMEBAD
  KNOWN_EVENTS="$KNOWN_EVENTS" python3 - "$SESS" <<'PY' >> "$T/issues"
import ctypes, ctypes.util, glob, json, os, sys, time

def load():
    for c in [ctypes.util.find_library('zstd'),
              '/lib/aarch64-linux-gnu/libzstd.so.1',
              '/usr/lib/aarch64-linux-gnu/libzstd.so.1',
              '/lib/x86_64-linux-gnu/libzstd.so.1',
              '/usr/lib/x86_64-linux-gnu/libzstd.so.1', 'libzstd.so.1']:
        if not c: continue
        try: return ctypes.CDLL(c)
        except OSError: pass
    return None

lib = load()
if lib is None:
    print('NOZLIB')
    sys.exit(0)

lib.ZSTD_findFrameCompressedSize.restype = ctypes.c_size_t
lib.ZSTD_findFrameCompressedSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_decompress.restype = ctypes.c_size_t
lib.ZSTD_decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_getFrameContentSize.restype = ctypes.c_ulonglong
lib.ZSTD_getFrameContentSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_isError.restype = ctypes.c_uint
lib.ZSTD_isError.argtypes = [ctypes.c_size_t]

def frames(buf):
    out, off, n = [], 0, len(buf)
    while off < n:
        sz = lib.ZSTD_findFrameCompressedSize(buf[off:], n - off)
        if lib.ZSTD_isError(sz) or sz == 0: break
        out.append((off, sz)); off += sz
    return out

def dec(data):
    csz = lib.ZSTD_getFrameContentSize(data, len(data))
    cap = csz if csz < (1 << 60) else len(data) * 200 + 65536
    dst = ctypes.create_string_buffer(cap)
    r = lib.ZSTD_decompress(dst, cap, data, len(data))
    if lib.ZSTD_isError(r): raise RuntimeError('decompress')
    return dst.raw[:r]

root = sys.argv[1]
known = set(os.environ['KNOWN_EVENTS'].split())
LIVE_WINDOW = 120.0   # 秒。这之内被改过的文件，很可能正在被写入
now = time.time()

def _active(path):
    # 跳过已经被手工移出的会话：目录名以 .disabled 结尾，
    # 或者文件名叫 session.v4.jsonl.zstd.disabled 之类。
    parts = path.split(os.sep)
    for p in parts:
        if p.endswith('.disabled') or p.endswith('.deleted'):
            return False
    return True

_all = sorted(glob.glob(os.path.join(root, '**', 'session.v*.jsonl.zstd'), recursive=True))
for path in [p for p in _all if _active(p)]:
    # 正在写入的会话不要判它「断档 / 撕裂」——
    # 读到一半时最后那个帧本来就只有半条记录，是正常的进行态。
    try:
        if now - os.path.getmtime(path) < LIVE_WINDOW:
            print('LIVE\t%s' % path)
            continue
    except OSError:
        pass
    try:
        buf = open(path, 'rb').read()
        fr = frames(buf)
        if not fr: raise RuntimeError('no frames')
        first = dec(buf[fr[0][0]:fr[0][0] + fr[0][1]])
        one_line = len(first) > 0 and first.count(b'\n') == 1 and first.endswith(b'\n')
        if not one_line:
            print('FRAMEBAD\t%s\t%d' % (path, len(fr)))
        content = b''.join(dec(buf[o:o + s]) for o, s in fr)
    except Exception:
        print('UNREADABLE\t%s' % path)
        continue
    # 空会话：只有预设、没有真正的对话，而且没有 session/end-seed。
    # 这类会话是「点开新对话、一句话没说就关了」留下的。
    # 实测应用读它们会报 torn JSONL record —— 因为 restore 解码失败，
    # committedBytes 没走到末尾。内容本身没问题，是语义不完整。
    types_seen = set()
    has_talk = False
    has_end = False
    for _l in content.split(b'\n'):
        if not _l.strip():
            continue
        try:
            _d = json.loads(_l)
        except Exception:
            continue
        _t = _d.get('type') or ''
        types_seen.add(_t)
        if _t in ('user/message', 'assistant/message'):
            has_talk = True
        if _t == 'session/end-seed':
            has_end = True
    if not has_talk and not has_end:
        print('EMPTY\t%s\t%s' % (path, ','.join(sorted(types_seen))))

    prev = 0; gap = None
    for line in content.split(b'\n'):
        if not line.strip(): continue
        try: d = json.loads(line)
        except Exception: continue
        q = d.get('seq')
        if isinstance(q, int):
            if gap is None and prev and q != prev + 1: gap = (prev, q)
            prev = q
        t = d.get('type') or ''
        if t and t not in known:
            print('NONCORE\t%s\t%s' % (path, t))
    if gap:
        print('GAP\t%s\t%d\t%d' % (path, gap[0], gap[1]))
PY
fi

NOZLIB=$(grep -c '^NOZLIB' "$T/issues" 2>/dev/null || true)
LIVE_N=$(grep -c '^LIVE' "$T/issues" 2>/dev/null || true)
EMPTY_N=$(grep -c '^EMPTY' "$T/issues" 2>/dev/null || true)
FR_BAD=$(grep -c '^FRAMEBAD' "$T/issues" 2>/dev/null || true)
UNREADABLE=$(grep -c '^UNREADABLE' "$T/issues" 2>/dev/null || true)
GAPS=$(grep -c '^GAP' "$T/issues" 2>/dev/null || true)
NC_TYPES=$(grep '^NONCORE' "$T/issues" 2>/dev/null | cut -f3 | sort -u | tr '\n' ' ' | sed 's/ $//')
NC_COUNT=$(grep -c '^NONCORE' "$T/issues" 2>/dev/null || true)

NOZLIB=${NOZLIB:-0}; FR_BAD=${FR_BAD:-0}; LIVE_N=${LIVE_N:-0}; EMPTY_N=${EMPTY_N:-0}
UNREADABLE=${UNREADABLE:-0}; GAPS=${GAPS:-0}; NC_COUNT=${NC_COUNT:-0}
case "$FR_BAD" in *[!0-9]*|"") FR_BAD=0;; esac
case "$LIVE_N" in *[!0-9]*|"") LIVE_N=0;; esac
case "$EMPTY_N" in *[!0-9]*|"") EMPTY_N=0;; esac
case "$UNREADABLE" in *[!0-9]*|"") UNREADABLE=0;; esac
case "$GAPS" in *[!0-9]*|"") GAPS=0;; esac
case "$NC_COUNT" in *[!0-9]*|"") NC_COUNT=0;; esac

# ---- 3. 备份新鲜度 ----
LAST_BK=$(ls -t /sdcard/Download/dsh-backup-*.tar.gz \
               /sdcard/Download/dsh-backup/dsh-backup-*.tar.gz 2>/dev/null | head -1)
if [ -n "$LAST_BK" ]; then
  BK_AGE=$(( (NOW - $(stat -c %Y "$LAST_BK" 2>/dev/null || echo "$NOW")) / 86400 ))
else
  BK_AGE=-1
fi

# ============================================================
#  输出
# ============================================================
if [ "$MODE" = "json" ]; then
  python3 - "$TOOLS_VERSION" "$APPV" "$FMT" "$N_SESS" "$GAPS" "$NC_COUNT" "$NC_TYPES" "$UNREADABLE" "$BK_AGE" "$LAST_BK" <<'PY'
import json, sys
a, appv, fmt, n, gaps, unk, unkt, unr, age, bk = sys.argv[1:11]
print(json.dumps({
  "tools_version": a, "app_version": appv, "session_format": fmt,
  "sessions": int(n or 0), "seq_gaps": int(gaps or 0),
  "unknown_events": int(unk or 0), "unknown_types": unkt.split(),
  "unreadable": int(unr or 0), "backup_age_days": int(age),
  "last_backup": bk or None,
  "problems": int(gaps or 0) + int(unk or 0) + int(unr or 0),
}, ensure_ascii=False, indent=2))
PY
  exit 0
fi

say "🩺 dsh-doctor $TOOLS_VERSION"
say ""
say "环境"
say "  dsh 目录:   $DSH"
say "  应用版本:   $APPV"
if [ -n "$MISS" ]; then
  say "  依赖:       ⚠️  缺:$MISS"
else
  say "  依赖:       ✅ 齐全"
fi
say ""
say "会话（$N_SESS 个）"
if [ -z "$FMT" ]; then
  say "  格式:       —（没有会话）"
elif [ "$FMT" = "$KNOWN_SESSION_FORMATS" ]; then
  say "  格式:       $FMT ✅"
else
  say "  格式:       $FMT ❌ 不认识（支持 $KNOWN_SESSION_FORMATS）"
fi
[ "$UNREADABLE" -gt 0 ] && say "  读不了:     ❌ $UNREADABLE 个" || say "  读不了:     ✅ 0"
[ "$GAPS" -gt 0 ]       && say "  seq 断档:   ⚠️  $GAPS 个" || say "  seq 断档:   ✅ 0"
[ "$NC_COUNT" -gt 0 ]  && say "  非核心事件: ℹ️  $NC_COUNT 条（$NC_TYPES）" || say "  非核心事件: ✅ 0"
# 帧布局 —— 最容易漏、后果最隐蔽的一项
if [ "$NOZLIB" -gt 0 ]; then
  say "  帧布局:     ⚠️  读不到 libzstd，这项没法查"
elif [ "$FR_BAD" -gt 0 ]; then
  say "  帧布局:     ❌ $FR_BAD 个首帧不是一行（应用会静默跳过）"
  say "              修: dsh-reframe --fix"
else
  say "  帧布局:     ✅ 全部合法"
fi
if [ "$LIVE_N" -gt 0 ]; then
  say "  正在写入:   $LIVE_N 个（120 秒内改过，已跳过判定）"
fi
if [ "$EMPTY_N" -gt 0 ]; then
  say "  空会话:     ⚠️  $EMPTY_N 个（只有预设、没有对话、没正常结束）"
fi
case "$EVENTS_SOURCE" in
  harness)  say "  事件表:     取自已安装的 harness（$(printf '%s' "$KNOWN_EVENTS" | wc -w) 种）" ;;
  fallback) say "  事件表:     ⚠️  读不到 harness，用的是内置参考列表"
            say "              结论可能不准 —— 装了 dsh-events 才可靠" ;;
  *)        say "  事件表:     ❌ 不可用" ;;
esac

# ---- 工作区索引 ----
# 会话列表读的是 workspace.json 里的 sessionIds，**不是扫目录**。
# 索引缺了 → 文件在、列表空。这是「帧布局」之外的另一个独立原因。
say ""
say "工作区索引:"
if have dsh-reindex; then
  RX=$(dsh-reindex 2>&1 | grep -E "索引和磁盘|索引有、磁盘没有|没有对应工作区" | head -3)
  if [ -z "$RX" ]; then
    say "             ❓ 读不到状态"
  else
    printf '%s\n' "$RX" | sed 's/^ */             /'
  fi
else
  say "             ⚠️  没装 dsh-reindex，这项没法查"
fi

say ""
say "备份"
if [ "$BK_AGE" -lt 0 ]; then
  say "  最近备份:   ⚠️  没有"
elif [ "$BK_AGE" -ge 30 ]; then
  say "  最近备份:   ⚠️  $BK_AGE 天前"
else
  say "  最近备份:   ✅ $BK_AGE 天前  $(basename "$LAST_BK")"
fi

TOTAL_PROB=$((UNREADABLE + GAPS + FR_BAD + EMPTY_N))
say ""
say "──────────────────────────────────────"
# 注意：指定了 --strip-type 就不能在这里退出 ——
# 用户明确要求剥某个类型，那本身就是要做的事。
if [ "$TOTAL_PROB" -eq 0 ] && [ -z "$STRIP_TYPE" ]; then
  say "✅ 没发现「确定的问题」（seq 断档 0，文件都能解开）"
  if [ "$NC_COUNT" -gt 0 ]; then
    say ""
    say "ℹ️  但有 $NC_COUNT 条非核心事件（上面列了类型）。"
    say "   工具**无法**判断这些会不会让应用读不了 —— 插件事件和"
    say "   新版本事件长得一样。"
    say ""
    say "   如果你确实打不开某个会话，看应用报的错："
    say '     contains event type "xxx" unknown to this harness'
    say "   把那个 xxx 交给："
    say "     dsh-doctor --fix --strip-type xxx"
  fi
  exit 0
fi

say "发现 $TOTAL_PROB 个问题"
say ""
if [ "$UNREADABLE" -gt 0 ]; then
  say "  ❌ 读不了的文件（工具帮不上，需要看具体报错）:"
  grep '^UNREADABLE' "$T/issues" | cut -f2 | sed "s|$SESS/|     |" | head -5
  say ""
fi
if [ "$EMPTY_N" -gt 0 ]; then
  say "  ⚠️  空会话（只有预设、没有对话、没正常结束）:"
  grep '^EMPTY' "$T/issues" | cut -f2 | sed "s|$SESS/|     |" | head -8
  say ""
  say "     这些是「点开新对话、一句话没说就关了」留下的。"
  say "     应用读它们可能报 corrupt / torn JSONL record —— 内容本身没问题，"
  say "     只是语义不完整（缺 session/end-seed）。"
  say ""
  say "     ⚠️  不要原地改名！harness 会用 header 里的 id + cwd 反推「应该在的路径」，"
  say "        路径对不上就判 corrupt，连带把 workspaceRegistry 拖挂 ——"
  say "        结果是整个对话列表空掉、打开文件夹也失败。"
  say ""
  say "     正确做法：把它们搬到 sessions/ 外面（扫不到就不会报错）。"
  say "     先停 Web，再复制执行："
  say ""
  say "       mkdir -p /root/.dsh/_quarantine"
  # 直接拼一条 mv，多个源 + 一个目标目录 —— 不需要循环变量，
  # 也就不会出现 \$d 被提前展开的问题
  say "       mv \\"
  grep '^EMPTY' "$T/issues" | cut -f2 | sed 's|/session\.v[0-9]*\.jsonl\.zstd$||' | while IFS= read -r _dir; do
    say "         \"$_dir\" \\"
  done
  say "         /root/.dsh/_quarantine/"
  say ""
  say "     （也可以直接忽略 —— 它们不占地方，只是每次会弹一个错误）"

fi
if [ "$FR_BAD" -gt 0 ]; then
  say "  ❌ 帧布局不对（应用会静默跳过，内容完好）:"
  grep '^FRAMEBAD' "$T/issues" | cut -f2 | sed "s|$SESS/|     |" | head -5
  say ""
  say "     修: dsh-reframe --fix"
  say ""
fi
if [ "$GAPS" -gt 0 ]; then
  say "  ⚠️  seq 断档（可自动修）:"
  grep '^GAP' "$T/issues" | cut -f2 | sed "s|$SESS/|     |" | head -5
  say ""
fi
if [ "$NC_COUNT" -gt 0 ]; then
  say "  ℹ️  非核心事件（仅供参考，**不建议**自动剥离）:"
  grep '^NONCORE' "$T/issues" | cut -f3 | sort | uniq -c | sed 's/^/     /'
  say ""
  say "     这些不在 harness 核心表里。可能是插件事件，也可能是"
  say "     新版本引入的。**两者长得一样，工具分不出来。**"
  say ""
  say "     判断方法：应用打开某个会话时如果报"
  say "       contains event type \"xxx\" unknown to this harness"
  say "     那个 xxx 就是真凶。把它显式交给 dsh-strip："
  say "       dsh-doctor --fix --strip-type xxx"
  say ""
fi

if [ "$MODE" = "check" ]; then
  say "修复方案:"
  [ "$GAPS" -gt 0 ]      && say "  dsh-repair        # 重排 seq，内容不丢"
  [ -n "$STRIP_TYPE" ]   && say "  dsh-strip <文件> $STRIP_TYPE"
  say ""
  say "或者:"
  say "  dsh-doctor --fix                      # 只修 seq 断档（安全）"
  say "  dsh-doctor --fix --strip-type <类型>  # 再剥掉指定类型"
  say ""
  say "⚠️  修改前会先停 Web（会话文件是活的），并备份成 *.before-doctor"
  exit 1
fi

# ============================================================
#  --fix
# ============================================================
say "🔧 开始修复"
say ""

# 检查 Web 是否还在跑（活会话不要动）
if pgrep -f "dsh.*web" >/dev/null 2>&1; then
  warn "检测到 Web 还在运行。"
  warn "会话文件是活的，边读边写 —— 现在改可能读到写了一半的状态。"
  warn ""
  warn "建议先在应用里 停止 Web，再跑 --fix。"
  warn "确实要继续就加 --i-know："
  warn "  dsh-doctor --fix --i-know"
  case " $* " in
    *" --i-know "*) warn "  已指定 --i-know，继续" ;;
    *) exit 1 ;;
  esac
fi

FIXED=0
FAILED=0

# --- 先备份所有要动的文件 ---
printf '%s\n' "$SESS_FILES" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f.before-doctor" ] || cp -a "$f" "$f.before-doctor" 2>/dev/null || true
done
say "  💾 已备份到 *.before-doctor"
say ""

# --- 修 seq 断档 ---
if [ "$GAPS" -gt 0 ]; then
  say "  ▸ 修 seq 断档..."
  if have dsh-repair; then
    dsh-repair 2>&1 | sed 's/^/     /'
  else
    say "     ⚠️  没装 dsh-repair，跳过"
  fi
  say ""
fi

# --- 剥未知事件 ---
if [ -n "$STRIP_TYPE" ]; then
  say "  ▸ 给事件打 ignorable 标记: $STRIP_TYPE"
  printf '%s\n' "$SESS_FILES" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    :
    if have dsh-strip; then
      say "     $(basename "$(dirname "$f")")"
      # 默认用 --mark（打 ignorable 标记）：不删行、不重排 seq，
      # 这是 harness 官方支持的放行方式，最安全。
      # 要真的删掉才加 --remove。
      if [ "$STRIP_MODE" = "remove" ]; then
        dsh-strip "$f" $STRIP_TYPE 2>&1 | grep -E "保留|残留" | sed 's/^/       /'
      else
        dsh-strip --mark "$f" $STRIP_TYPE 2>&1 | grep -E "打 ignorable|保留|条" | sed 's/^/       /'
      fi
      [ -f "$f.stripped" ] && mv "$f.stripped" "$f"
    else
      say "     ⚠️  没装 dsh-strip，跳过"
    fi
  done
  say ""
fi

say "──────────────────────────────────────"
say "✅ 修复完成"
say ""
say "回退:"
say "  dsh-doctor --rollback"
say ""
say "验证:"
say "  dsh-doctor"
