#!/bin/sh
# ============================================================
#  dsh-restore —— 从 dsh-backup 的包还原数据
#
#  用法:  dsh-restore <包路径> [--all]
#
#  默认只还原「纯数据」：
#    sessions / attachments / plugin-src / meme-packs / plugin-kits / profiles
#
#  不还原（覆盖会弄坏新环境）：
#    - 状态文件（plugin-activations.json 等）
#    - workspace.json
#    - home/.bashrc（含旧机路径）
#   加 --all 才连这些一起还原。
# ============================================================
set -u

PKG=""
MODE="safe"
FORCE=0
DRY=0
HOME_DIR="${HOME:-/root}"
DSH="$HOME_DIR/.dsh"

for a in "$@"; do
  case "$a" in
    --all)     MODE="--all" ;;
    --force)   FORCE=1 ;;
    -n|--dry-run) DRY=1 ;;
    -*)        ;;                 # 其它未知开关忽略
    *)         [ -z "$PKG" ] && PKG="$a" ;;
  esac
done

say() { printf '%s\n' "$*"; }
die() { printf '❌ %s\n' "$*" >&2; exit 1; }

case "${PKG:-}" in
  -h|--help|"")
    cat <<'HLP'
用法: dsh-restore <包路径> [--all] [--force] [--dry-run]

  从 dsh-backup 生成的包还原数据。

  默认只还原纯数据（sessions / attachments / plugin-src /
  meme-packs / plugin-kits / profiles），
  不覆盖状态文件，覆盖前自动备份成 *.before-restore。

  ⚠️ 默认不覆盖「比备份新」的文件。
     备份是过去某一刻的快照，如果现场数据更新（比如用 dsh-repair
     修过会话），直接覆盖会让它退回旧状态。所以逐文件比修改时间。

  --all       连状态文件和 .bashrc 一起还原（谨慎）
  --force     强制覆盖，不管修改时间
  --dry-run   只看会做什么，不实际写

示例:
  dsh-restore /sdcard/Download/dsh-backup/dsh-backup-20261022-1117.tar.gz
HLP
    exit 0
    ;;
esac

[ -f "$PKG" ] || die "找不到文件: $PKG"
PKG=$(cd "$(dirname "$PKG")" && pwd)/$(basename "$PKG")
[ -d "$DSH" ] || die "找不到 $DSH"

# ============================================================
#  一、先把包检查干净
#
#  ⚠️ 这一步以前做得很差：直接 tar 解压，失败就报
#     「解压失败（包可能损坏）」，还把 tar 的原始报错用
#     2>/dev/null 丢掉了。用户完全不知道自己该重传、还是
#     该清空间、还是文件格式不对。
# ============================================================
say "🔍 检查包..."
say "   $PKG"

BYTES=$(stat -c%s "$PKG" 2>/dev/null || echo 0)
say "   大小: $BYTES 字节"

[ "$BYTES" -ge 1024 ] || die "文件只有 $BYTES 字节，肯定没传完。重新传一次。"

# ---- 能不能读 ----
# ⚠️ /sdcard 是 FUSE 挂载，有 SELinux / uid 限制。
#    proot 里的 root 并不等于真 root —— ls 列得出来、open() 照样被拒。
#    所以「文件在」不等于「读得了」，必须单独查。
if [ ! -r "$PKG" ] || ! head -c 1 "$PKG" >/dev/null 2>&1; then
  say ""
  say "⚠️  文件在，但读不了。"
  die "没权限打开这个文件。

   DSHA 需要文件访问权限：
     设置 → 设备能力授权 → 打开文件访问

   或者先复制到工作区再还原（绕开 /sdcard 的限制）：
     cp \"$PKG\" ~/ && dsh-restore ~/$(basename \"$PKG\")"
fi

# ---- 魔数（可选查）----
# ⚠️ od 不是每个环境都装。装了就用它提前认出 zip；没装就跳过，
#    交给下面的 gzip -t —— 它不依赖任何额外工具，才是权威判断。
if command -v od >/dev/null 2>&1; then
  MAGIC=$(od -An -tx1 -N2 "$PKG" 2>/dev/null | tr -d ' \n')
  if [ "$MAGIC" = "504b" ]; then
    die "这不是 gzip 文件（魔数 504b = zip 压缩包）。
   传输工具可能把它压成了 zip。试试: unzip \"$PKG\""
  fi
fi

# ---- 完整性（权威判断）----
if ! GZERR=$(gzip -t "$PKG" 2>&1); then
  say ""
  say "gzip 的原始报错:"
  printf '%s\n' "$GZERR" | sed 's/^/   /'
  say ""
  case "$GZERR" in
    *"Permission denied"*)
      die "没权限读这个文件。

   DSHA 需要文件访问权限：
     设置 → 设备能力授权 → 打开文件访问

   或者先复制到工作区再还原：
     cp \"$PKG\" ~/ && dsh-restore ~/$(basename \"$PKG\")" ;;
    *"not in gzip format"*)
      die "不是 gzip 格式。文件可能被改名或转成了别的压缩格式。
   看看它的真面目: file \"$PKG\"（如果装了 file）" ;;
    *"unexpected end of file"*|*"unexpected EOF"*)
      die "包不完整（大小 $BYTES 字节，比正常的小）。
   多半是传输中断，重新传一次。" ;;
    *)
      die "包校验失败（大小 $BYTES 字节）。把上面的报错发给 AI 帮你看。" ;;
  esac
fi
say "   完整性: ✅ gzip 校验通过"

# ---- 逃逸软链 ----
BADLINK=$(tar -tvzf "$PKG" 2>/dev/null | awk '$1 ~ /^l/ && ($NF ~ /^\// || $NF ~ /\.\.\/\.\./)' | wc -l)
if [ "$BADLINK" -gt 0 ]; then
  say "   ⚠️  有 $BADLINK 个逃逸软链，解压时会跳过（不影响其它文件）"
fi

# ---- 磁盘空间 ----
# 解压后的实际大小 = 包里所有条目 size 之和
NEED=$(tar -tvzf "$PKG" 2>/dev/null | awk '{s+=$3} END{printf "%d", s/1024/1024}')
FREE=$(df -Pm "${TMPDIR:-/tmp}" 2>/dev/null | awk 'NR==2{print $4}')
if [ -n "$NEED" ] && [ -n "$FREE" ] && [ "$FREE" -lt "$((NEED + 50))" ]; then
  say "   ⚠️  临时空间可能不够：解压要 ${NEED} MB，${TMPDIR:-/tmp} 只剩 ${FREE} MB"
  say "      换个大点的地方: TMPDIR=/root/tmp dsh-restore \"$PKG\""
fi

# ============================================================
#  二、解压
# ============================================================
STAGE=$(mktemp -d "${TMPDIR:-/tmp}/dsh-restore.XXXXXX") || die "建不了临时目录"
trap 'rm -rf "$STAGE"' EXIT INT TERM

say ""
say "📂 解压到 $STAGE ..."
if ! TARERR=$(tar -xzpf "$PKG" -C "$STAGE" 2>&1); then
  say ""
  say "tar 的原始报错:"
  printf '%s\n' "$TARERR" | sed 's/^/   /'
  say ""
  case "$TARERR" in
    *"No space left"*)      die "空间不够。清一下 /tmp，或用 TMPDIR=/root/tmp 重试。" ;;
    *"Permission denied"*)  die "没权限。先 cp 到 ~/ 再还原。" ;;
    *"Cannot open"*)        die "打不开这个文件。检查路径和权限。" ;;
    *"not in gzip format"*) die "文件格式不对。检查是不是被改成了别的压缩格式。" ;;
    *)                      die "解压失败。上面是原始报错，可以发给 AI 帮你看。" ;;
  esac
fi

SRC=$(find "$STAGE" -maxdepth 1 -mindepth 1 -type d | head -1)
[ -n "$SRC" ] || die "解开了但里面没有目录，包可能是空的"
say "   内容: $(ls "$SRC" | tr '\n' ' ')"

# ============================================================
#  三、逐项还原
# ============================================================
restore_dir() {
  name="$1"; src="$SRC/$1"; dst="$DSH/$1"
  [ -d "$src" ] || { say "   ⏭  $name（包内没有）"; return; }

  if [ -e "$dst" ] && [ "$DRY" = "0" ]; then
    backup="${dst}.before-restore"
    [ -e "$backup" ] && rm -rf "$backup"
    cp -a "$dst" "$backup" 2>/dev/null || true
    say "   💾 已备份现有 $name → $(basename "$backup")"
  fi
  [ "$DRY" = "1" ] || mkdir -p "$dst"

  # ------------------------------------------------------------
  #  ⚠️ 这里以前是 cp -a "$src/." "$dst/" —— 无条件覆盖。
  #
  #     问题：备份是「过去某个时刻」的快照。如果现场数据比备份新
  #     （比如你用 dsh-repair 修过会话、或者备份后又聊了几句），
  #     还原会把更新的数据抹掉，退回到旧状态。
  #
  #     实测踩过：dsh-repair 修好一个会话（7.7 MB），随后还原了一个
  #     修复前的备份，会话被 13.5 MB 的旧版覆盖，打不开了。
  #
  #     现在改成逐文件比 mtime：现场比包里新的就跳过。
  #     要强制覆盖用 --force。
  # ------------------------------------------------------------
  LOG="$STAGE/restore-$name.log"
  : > "$LOG"

  find "$src" -type f 2>/dev/null | while IFS= read -r f; do
    rel="${f#$src/}"
    d="$dst/$rel"

    if [ -e "$d" ] && [ "$FORCE" = "0" ]; then
      st=$(stat -c %Y "$f" 2>/dev/null || echo 0)
      dt=$(stat -c %Y "$d" 2>/dev/null || echo 0)
      if [ "$dt" -gt "$st" ]; then
        printf 'SKIP\t%s\n' "$rel" >> "$LOG"
        continue
      fi
    fi

    if [ "$DRY" = "1" ]; then
      printf 'COPY\t%s\n' "$rel" >> "$LOG"
      continue
    fi

    mkdir -p "$(dirname "$d")" 2>/dev/null
    if cp -a "$f" "$d" 2>/dev/null; then
      printf 'COPY\t%s\n' "$rel" >> "$LOG"
    else
      printf 'FAIL\t%s\n' "$rel" >> "$LOG"
    fi
  done

  # 符号链接单独处理（不跟时间比，缺了才补）
  find "$src" -type l 2>/dev/null | while IFS= read -r f; do
    rel="${f#$src/}"
    d="$dst/$rel"
    [ -e "$d" ] && continue
    [ "$DRY" = "1" ] && continue
    mkdir -p "$(dirname "$d")" 2>/dev/null
    cp -a "$f" "$d" 2>/dev/null || true
  done

  c=$(grep -c '^COPY' "$LOG" 2>/dev/null || true)
  k=$(grep -c '^SKIP' "$LOG" 2>/dev/null || true)
  x=$(grep -c '^FAIL' "$LOG" 2>/dev/null || true)
  c=${c:-0}; k=${k:-0}; x=${x:-0}

  if [ "$DRY" = "1" ]; then
    say "   🔎 $name（会写入 $c，会跳过 $k）"
  elif [ "$k" -gt 0 ]; then
    say "   ✅ $name（写入 $c，跳过 $k 个比备份新的）"
    grep '^SKIP' "$LOG" 2>/dev/null | head -5 | while IFS="$(printf '\t')" read -r _ rel; do
      say "      跳过: $rel"
    done
    [ "$k" -gt 5 ] && say "      …还有 $((k-5)) 个（--force 可强制覆盖）"
  else
    say "   ✅ $name（写入 $c）"
  fi
  [ "$x" -gt 0 ] && say "   ⚠️  $name 有 $x 个文件复制失败"
}

say ""
say "♻️  还原中..."
restore_dir sessions
restore_dir attachments
restore_dir plugin-src
restore_dir meme-packs
restore_dir plugin-kits
restore_dir profiles

# 配置：只补缺的，不覆盖已有的
if [ -d "$SRC/config" ]; then
  say ""
  say "⚙️  配置（只补缺，不覆盖）:"
  mkdir -p "$DSH/config"
  for f in "$SRC"/config/*; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    if [ -e "$DSH/config/$b" ]; then
      say "   ⏭  $b（已有，保留）"
    else
      cp -a "$f" "$DSH/config/$b" && say "   ➕ $b"
    fi
  done
fi

# ---------- --all 才动的东西 ----------
if [ "$MODE" = "--all" ]; then
  say ""
  say "⚠️  --all 模式：额外还原状态文件"
  for f in "$SRC"/config/*.json "$SRC/workspace.json"; do
    [ -f "$f" ] || continue
    cp -a "$f" "$DSH/$(basename "$f")" 2>/dev/null && say "   ✅ $(basename "$f")"
  done
  for f in "$SRC"/home/.bashrc "$SRC"/home/.profile; do
    [ -f "$f" ] || continue
    [ -e "$HOME_DIR/$(basename "$f")" ] && cp -a "$HOME_DIR/$(basename "$f")" "$HOME_DIR/$(basename "$f").before-restore"
    cp -a "$f" "$HOME_DIR/" && say "   ✅ home/$(basename "$f")"
  done
fi

# ---------- 检查目录名 ----------
if [ -d "$DSH/sessions" ]; then
  say ""
  say "📁 sessions 目录:"
  ls "$DSH/sessions" | sed 's/^/   /'
  say ""
  say "   ⚠️  目录名必须和当前工作区路径对应（形如 --root-xxx--）"
  say "      对不上就在应用里看不到旧对话。"
fi

say ""
say "✅ 还原完成"
say ""
say "下一步："
say "   1. 重启 Web（在应用里 停止 → 启动）"
say "   2. 重启后打开对话列表，看看旧对话在不在"
say "   3. 让 AI 发个表情包，确认插件正常"
say ""
say "如果出问题，回滚："
say "   rm -rf $DSH/plugin-src && mv $DSH/plugin-src.before-restore $DSH/plugin-src"
