#!/usr/bin/env python3
# ============================================================
#  dsh-strip —— 从会话日志里剥掉指定事件类型
#
#  什么时候用：
#    应用打开某个会话时报
#      contains event type "xxx" unknown to this harness
#      and not marked ignorable; refusing to interpret the log
#    把那个 xxx 剥掉，日志就能被读了。
#
#  ⚠️ 不要为了「降级到旧版」用它 —— 降级这条路走不通。
#     旧版读不了新版写的日志是设计如此（日志只往前兼容），
#     剥事件只是让旧版「能打开」，但旧版还会写回旧格式，
#     下次新版又读不了。来回折腾，越折腾越乱。
#     正确做法：升到写这份日志的版本。
#
#  ⚠️ 写回时必须切对帧：
#     DSH 的读取器要求**首帧恰好一行**（header）。整份压成一个帧
#     会被判损坏并静默跳过 —— 文件在、界面没有、也不报错。
#     早期版本这里用 `zstd -o` 重压，写出来就是单帧，把好文件写坏过。
#     现在改成：首帧只装 header 行，正文另起一帧。
#
#  两种修法，优先用 --mark：
#
#    --mark  给事件加 "ignorable": true —— **官方支持的放行方式**
#            （validateStoredEvents 里就认这个字段）
#            不删行、不动 seq，应用内部计数器不会失配。
#
#    默认    删掉事件 + 重排 seq。**不推荐**：删行会让应用内部的
#            seq 计数器不同步，之后它继续写就会留下断档，
#            整个会话又从列表里消失。只在 --mark 不奏效时兜底。
#
#  用法:
#    dsh-strip --list <文件>                 看有哪些事件类型
#    dsh-strip --mark <文件> <类型...>       打 ignorable 标记（推荐）
#    dsh-strip --mark --dry-run <文件> <类型...>
#    dsh-strip --dry-run <文件> <类型...>    只看会删多少
#    dsh-strip <文件> <类型...>              真删（兜底，不推荐）
#    dsh-strip --rollback                    回退（*.before-strip）
#
#  依赖：python3 + libzstd
# ============================================================
import ctypes
import ctypes.util
import glob
import json
import os
import shutil
import sys

VERSION = "2.0.0"
BAK_SUFFIX = '.before-strip'


def _load_lib():
    for c in [ctypes.util.find_library('zstd'),
              '/lib/aarch64-linux-gnu/libzstd.so.1',
              '/usr/lib/aarch64-linux-gnu/libzstd.so.1',
              '/lib/x86_64-linux-gnu/libzstd.so.1',
              '/usr/lib/x86_64-linux-gnu/libzstd.so.1',
              'libzstd.so.1']:
        if not c:
            continue
        try:
            return ctypes.CDLL(c)
        except OSError:
            continue
    raise RuntimeError('找不到 libzstd')


lib = _load_lib()
lib.ZSTD_findFrameCompressedSize.restype = ctypes.c_size_t
lib.ZSTD_findFrameCompressedSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_decompress.restype = ctypes.c_size_t
lib.ZSTD_decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_getFrameContentSize.restype = ctypes.c_ulonglong
lib.ZSTD_getFrameContentSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
lib.ZSTD_compress.restype = ctypes.c_size_t
lib.ZSTD_compress.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
lib.ZSTD_compressBound.restype = ctypes.c_size_t
lib.ZSTD_compressBound.argtypes = [ctypes.c_size_t]
lib.ZSTD_isError.restype = ctypes.c_uint
lib.ZSTD_isError.argtypes = [ctypes.c_size_t]
lib.ZSTD_getErrorName.restype = ctypes.c_char_p
lib.ZSTD_getErrorName.argtypes = [ctypes.c_size_t]


def _err(rc):
    return lib.ZSTD_getErrorName(rc).decode()


def split_frames(buf):
    out, off, n = [], 0, len(buf)
    while off < n:
        sz = lib.ZSTD_findFrameCompressedSize(buf[off:], n - off)
        if lib.ZSTD_isError(sz):
            raise RuntimeError('帧定位失败 @%d: %s' % (off, _err(sz)))
        if sz == 0:
            break
        out.append((off, sz))
        off += sz
    return out


def decompress_frame(data):
    csz = lib.ZSTD_getFrameContentSize(data, len(data))
    cap = csz if csz < (1 << 60) else len(data) * 200 + 65536
    dst = ctypes.create_string_buffer(cap)
    r = lib.ZSTD_decompress(dst, cap, data, len(data))
    if lib.ZSTD_isError(r):
        raise RuntimeError('解压失败: %s' % _err(r))
    return dst.raw[:r]


def compress_frame(data, level=19):
    cap = lib.ZSTD_compressBound(len(data))
    dst = ctypes.create_string_buffer(cap)
    r = lib.ZSTD_compress(dst, cap, data, len(data), level)
    if lib.ZSTD_isError(r):
        raise RuntimeError('压缩失败: %s' % _err(r))
    return dst.raw[:r]


def read_all(path):
    buf = open(path, 'rb').read()
    return b''.join(decompress_frame(buf[o:o + s]) for o, s in split_frames(buf))


def write_session(path, content):
    """首帧只装 header 行，正文一帧 —— 这是 DSH 读取器要求的布局。"""
    nl = content.find(b'\n')
    if nl < 0:
        raise RuntimeError('内容里没有换行，不是合法会话日志')
    head, rest = content[:nl + 1], content[nl + 1:]
    pack = [compress_frame(head)]
    if rest:
        pack.append(compress_frame(rest))
    data = b''.join(pack)
    with open(path, 'wb') as f:
        f.write(data)
    return len(data)


def first_frame_is_one_line(path):
    buf = open(path, 'rb').read()
    fr = split_frames(buf)
    first = decompress_frame(buf[fr[0][0]:fr[0][0] + fr[0][1]])
    return len(first) > 0 and first.count(b'\n') == 1 and first.endswith(b'\n')


def iter_events(content):
    for line in content.split(b'\n'):
        if not line.strip():
            continue
        yield line


def main():
    args = sys.argv[1:]
    mode = 'strip'
    mark = False
    dry = False
    pos = []

    for a in args:
        if a in ('-h', '--help'):
            # 文件头是 # 注释，不是 docstring —— 直接把那段打出来。
            # dsh-recover 会 grep --mark，这里必须真的包含它。
            for line in open(__file__, encoding='utf-8'):
                if line.startswith('#!'):
                    continue
                if not line.startswith('#'):
                    break
                print(line.rstrip()[1:].lstrip('#').strip() if False else line.rstrip().lstrip('#').strip())
            return 0
        elif a == '--list':
            mode = 'list'
        elif a == '--dry-run':
            dry = True
        elif a == '--mark':
            mark = True
            mode = 'mark'
        elif a == '--rollback':
            mode = 'rollback'
        elif a.startswith('-'):
            print('❌ 不认识的选项: %s' % a, file=sys.stderr)
            return 1
        else:
            pos.append(a)

    if mode == 'rollback':
        home = os.path.expanduser('~')
        sess = os.path.join(home, '.dsh', 'sessions')
        n = 0
        for p in glob.glob(os.path.join(sess, '**', '*' + BAK_SUFFIX), recursive=True):
            dst = p[:-len(BAK_SUFFIX)]
            shutil.copy2(p, dst)
            print('  ↩︎  %s' % os.path.relpath(dst, sess))
            n += 1
        print('✅ 回退 %d 个' % n)
        return 0

    # 第一个非选项是文件，后面是类型；也接受「一段报错原文」，自动取第一个像类型的词
    if not pos:
        print('用法: dsh-strip <文件> <类型...>', file=sys.stderr)
        return 1

    path = pos[0]
    if not os.path.isfile(path):
        print('❌ 找不到文件: %s' % path, file=sys.stderr)
        return 1

    raw_types = pos[1:]
    # 容错：从报错里整段复制时，只保留像 "xx/yy" 的词
    types = []
    for t in raw_types:
        for tok in t.replace('"', ' ').replace("'", ' ').replace('(', ' ').replace(')', ' ').split():
            if '/' in tok and not tok.endswith('/'):
                types.append(tok)
                break
        else:
            # 没有斜杠也认（有些事件名不带 /）
            tok = t.strip().strip('"\'')
            if tok and '/' not in tok:
                types.append(tok)
    # 去重保序
    seen = set()
    types = [t for t in types if not (t in seen or seen.add(t))]

    try:
        content = read_all(path)
    except Exception as e:
        print('❌ 读不了: %s' % e, file=sys.stderr)
        return 1

    if mode == 'list':
        counts = {}
        bad = 0
        n = 0
        seqs = []
        for line in iter_events(content):
            n += 1
            try:
                d = json.loads(line)
            except Exception:
                bad += 1
                continue
            counts[d.get('type') or '?'] = counts.get(d.get('type') or '?', 0) + 1
            if isinstance(d.get('seq'), int):
                seqs.append(d['seq'])
        print('📊 事件类型分布')
        print('  总行数 %d  解析失败 %d  最大 seq %d' % (n, bad, max(seqs) if seqs else 0))
        ok = first_frame_is_one_line(path)
        print('  首帧一行: %s' % ('✅' if ok else '❌（应用会静默跳过，用 dsh-reframe 修）'))
        print()
        for t, c in sorted(counts.items(), key=lambda x: -x[1]):
            print('    %-44s %6d' % (t, c))
        return 0

    if not types:
        print('❌ 要指定事件类型。先用 --list 看看有哪些', file=sys.stderr)
        return 1


    # ------------------------------------------------------------
    #  --mark：给事件加 "ignorable": true（官方放行方式）
    #
    #  不删行、不动 seq —— 应用内部的 seq 计数器不会失配。
    #  输出写到 <文件>.stripped，和 dsh-recover 的约定一致。
    # ------------------------------------------------------------
    if mode == 'mark':
        print('🔖 打 ignorable 标记: %s' % ' '.join(types))
        drop = set(types)
        out_lines = []
        marked = 0
        seen_types = {t: 0 for t in types}
        total = 0
        for line in iter_events(content):
            total += 1
            try:
                d = json.loads(line)
            except Exception:
                out_lines.append(line)
                continue
            t = d.get('type') or ''
            if t in drop and d.get('ignorable') is not True:
                d['ignorable'] = True
                marked += 1
                seen_types[t] += 1
            out_lines.append(json.dumps(d, ensure_ascii=False, separators=(',', ':')).encode())

        print('  共 %d 行，打标 %d 条，seq 一个没动' % (total, marked))
        for t, c in seen_types.items():
            print('    %s: %d 条' % (t, c))

        if dry:
            print()
            print('（--dry-run，没有写任何文件）')
            return 0

        out = b'\n'.join(out_lines) + b'\n'
        dst = path + '.stripped'
        write_session(dst, out)

        # 自检
        if read_all(dst) != out:
            os.unlink(dst)
            print('❌ 自检失败（解回来不一致）', file=sys.stderr)
            return 1
        if not first_frame_is_one_line(dst):
            os.unlink(dst)
            print('❌ 自检失败（首帧不是一行）', file=sys.stderr)
            return 1

        print()
        print('✅ 完成: %s' % os.path.basename(dst))
        print('   首帧一行 ✅  seq 未改动 ✅')
        print()
        print('⚠️  调用方需要把它 mv 到原文件名（dsh-recover 会自动做）')
        return 0

    print('🔪 剥离: %s' % ' '.join(types))
    drop = set(types)
    kept = []
    dropped = 0
    seen_types = {t: 0 for t in types}
    seq = 0
    for line in iter_events(content):
        try:
            d = json.loads(line)
        except Exception:
            kept.append(line)
            continue
        t = d.get('type') or ''
        if t in drop:
            dropped += 1
            seen_types[t] += 1
            continue
        if 'seq' in d:
            seq += 1
            d['seq'] = seq
        kept.append(json.dumps(d, ensure_ascii=False, separators=(',', ':')).encode())

    print('  保留 %d 行，剥离 %d 行，重排 seq 1..%d' % (len(kept), dropped, seq))
    for t, c in seen_types.items():
        print('    %s: %d 条' % (t, c))

    if dry:
        print()
        print('（--dry-run，没有写任何文件）')
        return 0

    out = b'\n'.join(kept) + b'\n'
    if not os.path.exists(path + BAK_SUFFIX):
        shutil.copy2(path, path + BAK_SUFFIX)
        print('  💾 原文件存为 %s' % os.path.basename(path + BAK_SUFFIX))

    tmp = path + '.stripping'
    size = write_session(tmp, out)

    # 自检：解回来必须一致；首帧必须一行
    if read_all(tmp) != out:
        os.unlink(tmp)
        print('❌ 自检失败（解回来不一致），未改动原文件', file=sys.stderr)
        return 1
    if not first_frame_is_one_line(tmp):
        os.unlink(tmp)
        print('❌ 自检失败（首帧不是一行），未改动原文件', file=sys.stderr)
        return 1

    os.replace(tmp, path)
    print()
    print('✅ 完成')
    print('   文件 %d 字节（原 %d）' % (size, len(content and open(path + BAK_SUFFIX, 'rb').read())))
    print('   首帧一行 ✅')
    print()
    print('回退: dsh-strip --rollback')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
