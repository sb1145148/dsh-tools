#!/bin/sh
# ============================================================
#  dsh-strip —— 剥掉日志里「本版本不认识」的事件类型
#
#  症状（应用里看到的）：
#    failed to observe session "session-xxx":
#    contains event type "job/registered" (seq N)
#    unknown to this harness and not marked ignorable;
#    refusing to interpret the log
#    — it was likely written by a newer harness
#
#  原因：**日志是往前兼容、不往后兼容的。**
#    0.2.1 写的日志，0.2.0 读不懂 —— 而且不认识的事件没被标记成
#    可忽略时，整份日志会被拒绝解释，不是跳过那一条。
#
#  解法（两个）：
#    A. 升回写这份日志的版本 —— 正统做法，推荐
#    B. 用这个工具剥掉不认识的事件，重排 seq —— 留在旧版本时用
#
#  做法：删掉指定类型的事件，把剩下的 seq 重排成连续的。
#  其它内容一行不动。
#
#  用法:
#    dsh-strip --mark <文件> <类型> [类型...]      # 打 ignorable 标记（推荐）
#    dsh-strip --list <文件>                       # 只看有哪些事件类型
#    dsh-strip --dry-run <文件> <类型...>          # 只看会做什么，不写盘
#    dsh-strip <文件> <类型...>                    # 删除+重排 seq（有风险）
#
#  例:
#    dsh-strip --mark session.v4.jsonl.zstd job/registered job/settled
# ============================================================
set -u

show_help() {
  cat <<'HLP'
dsh-strip —— 处理会话日志里的事件类型

用法:
  dsh-strip --mark <文件> <类型> [类型...]   打 ignorable 标记（推荐，不删行不重排）
  dsh-strip --list <文件>                    列出日志里所有事件类型及条数
  dsh-strip --dry-run <文件> <类型...>       预演，不写盘
  dsh-strip <文件> <类型...>                 删除事件并重排 seq（旧行为，有风险）

说明:
  --mark     给指定类型的事件加 "ignorable": true。harness 看到这个
             标记会跳过该事件 —— 这是官方支持的放行方式，不删任何行、
             不改 seq，最安全。
  直接传类型 会删除事件并重排 seq。1.5.x 之前是默认行为，实测会导致
             应用内部计数器不同步、会话从列表消失。除非明确需要，别用。

例:
  dsh-strip --mark session.v4.jsonl.zstd job/registered job/settled
  dsh-strip --list session.v4.jsonl.zstd

环境变量:
  DSH_HARNESS_ROOTS   覆盖 harness 搜索路径（调试用）
  exit 0

HLP
}

say()  { printf '%s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }

DRY=0
MODE="strip"
MARK=0
SHOWHELP=0          # 1 = 只打 ignorable 标记，不删不重排
ARGS=""
for a in "$@"; do
  case "$a" in
    --list)    MODE="list" ;;
    -h|--help) SHOWHELP=1 ;;
    --dry-run) DRY=1 ;;
    --mark)    MARK=1 ;;
    -*)        die "不认识的选项: $a" ;;
    *)         ARGS="$ARGS
$a" ;;
  esac
done

# 第一个非选项参数是文件，剩下的是类型
FILE=$(printf '%s' "$ARGS" | sed -n '2p')
TYPES=$(printf '%s' "$ARGS" | sed '1,2d' | tr '\n' ' ' | sed 's/ *$//')

[ "$SHOWHELP" = "1" ] && show_help
[ -n "$FILE" ] || die "用法: dsh-strip --mark <文件> <类型...>   （--help 看全部）"
[ -f "$FILE" ] || die "找不到文件: $FILE"
command -v zstd >/dev/null 2>&1 || die "需要 zstd"
command -v python3 >/dev/null 2>&1 || die "需要 python3"

T=$(mktemp -d "${TMPDIR:-/tmp}/dsh-strip.XXXXXX")
trap 'rm -rf "$T"' EXIT INT TERM

say "📂 解压..."
zstd -dc "$FILE" > "$T/in.jsonl" 2>/dev/null || die "解压失败"

# ---------- --list ----------
if [ "$MODE" = "list" ]; then
  say ""
  say "📊 事件类型分布:"
  python3 - "$T/in.jsonl" <<'PY'
import json, sys, collections
c = collections.Counter(); n = 0; bad = 0; mx = 0
for line in open(sys.argv[1], encoding='utf-8'):
    line = line.strip()
    if not line: continue
    n += 1
    try: d = json.loads(line)
    except Exception: bad += 1; continue
    c[d.get('type') or '?'] += 1
    s = d.get('seq')
    if isinstance(s, int) and s > mx: mx = s
print(f"  总行数 {n}  解析失败 {bad}  最大 seq {mx}")
print()
for t, k in c.most_common():
    print(f"    {t:<42} {k:>6}")
PY
  exit 0
fi

[ -n "$TYPES" ] || die "要指定事件类型。先用 --list 看看有哪些"

if [ "$MARK" = "1" ]; then
  say "🏷  打 ignorable 标记（不删、不重排）: $TYPES"
else
  say "🔪 剥离: $TYPES"
fi
DPY=$(printf '%s' "$TYPES" | tr ' ' ',')
python3 - "$T/in.jsonl" "$T/out.jsonl" "$DPY" "$DRY" "$MARK" <<'PY'
import json, sys
src, dst, drop, dry, mark = sys.argv[1], sys.argv[2], set(sys.argv[3].split(',')), sys.argv[4] == '1', sys.argv[5] == '1'
kept, dropped, seq, seen = [], 0, 0, {t: 0 for t in drop}
for line in open(src, encoding='utf-8'):
    line = line.rstrip('\n')
    if not line:
        continue
    try:
        d = json.loads(line)
    except Exception:
        kept.append(line); continue
    t = d.get('type') or ''
    if t in drop:
        seen[t] += 1
        if mark:
            # 官方支持的放行标记：harness 看到 ignorable===true 就跳过这个事件，
            # 不删、不重排 —— seq 连续性完全不动，最安全
            d['ignorable'] = True
            kept.append(json.dumps(d, ensure_ascii=False, separators=(',', ':')))
            continue
        dropped += 1
        continue
    if not mark and 'seq' in d:
        seq += 1
        d['seq'] = seq
    kept.append(json.dumps(d, ensure_ascii=False, separators=(',', ':')))
open(dst, 'w', encoding='utf-8').write('\n'.join(kept) + '\n')
if mark:
    total = sum(seen.values())
    print(f"  保留 {len(kept)} 行，其中打了标记 {total} 条（没删任何行，seq 没动）")
else:
    print(f"  保留 {len(kept)} 行，剥离 {dropped} 行，重排 seq 1..{seq}")
for t, k in seen.items():
    print(f"    {t}: {k} 条")
PY

if [ "$DRY" = "1" ]; then
  say ""
  say "（--dry-run，没有写任何文件）"
  exit 0
fi

OUT="$FILE.stripped"
say "🗜  压缩..."
zstd -q -f -19 -o "$OUT" "$T/out.jsonl" 2>/dev/null || die "压缩失败"

# ---------- 自检 ----------
# 用实际剥离的类型做残留检查，不要写死
PAT=$(printf '%s' "$TYPES" | tr ' ' '\n' | sed 's/[][()*+?.^$|\\]/\\&/g' | grep . | paste -sd'|' -)
if [ -n "$PAT" ]; then
  if [ "$MARK" = "1" ]; then
  LEFT=0   # 打标记模式本来就不删，残留是正常的
else
  LEFT=$(zstd -dc "$OUT" 2>/dev/null | grep -c -E "\"type\":\"($PAT)\"" 2>/dev/null || true)
fi
else
  LEFT=0
fi
LEFT=${LEFT:-0}
N=$(zstd -dc "$OUT" 2>/dev/null | wc -l)

say ""
say "✅ 完成"
say "   输出: $OUT"
say "   大小: $(stat -c%s "$OUT") 字节（原 $(stat -c%s "$FILE")）"
say "   行数: $N"
say "   残留指定类型: $LEFT"
[ "$LEFT" -gt 0 ] && warn "还有残留，检查一下类型名是不是打错了"

say ""
say "下一步："
say "   1. 先停 Web（会话文件是活的，边读边写）"
say "   2. cp -a \"$FILE\" \"$FILE.before-strip\""
say "   3. mv \"$OUT\" \"$FILE\""
say "   4. 启动 Web，打开那个会话确认"
